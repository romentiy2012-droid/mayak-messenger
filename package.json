{
  "name": "mayak-messenger",
  "version": "2.22.3",
  "description": "Маяк — закрытый облачный PWA-чат",
  "main": "app.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "esbuild src/supabase-client.js --bundle --format=iife --global-name=MayakSupabase --minify --target=safari15,chrome100 --outfile=vendor/supabase.js",
    "test": "node --test tests/database.test.cjs tests/push.test.cjs tests/features.test.cjs tests/reliability.test.cjs tests/admin.test.cjs tests/media.test.cjs tests/direct.test.cjs tests/join.test.cjs tests/avatars.test.cjs tests/video.test.cjs tests/video-edge.test.cjs tests/storage.test.cjs tests/storage-edge.test.cjs tests/storage-adapter.test.cjs tests/polls.test.cjs tests/polls-adapter.test.cjs",
    "test:ui": "playwright test",
    "test:avatars-ui": "node --test tests/avatars-ui.cjs",
    "test:video-ui": "node --test tests/video-ui.cjs",
    "test:video-recorder-ui": "node --test tests/video-recorder-ui.cjs",
    "test:video-actions-ui": "node --test tests/video-actions-ui.cjs",
    "test:message-menu-ui": "node --test tests/message-menu-ui.cjs",
    "test:storage-ui": "node --test tests/storage-ui.cjs",
    "test:video-worker": "npm test --prefix video-worker",
    "test:stickers-ui": "node --test tests/stickers-ui.cjs",
    "test:message-details-ui": "node --test tests/message-details-ui.cjs",
    "test:session-ui": "node --test tests/session-ui.cjs",
    "test:updates-ui": "node --test tests/updates-ui.cjs",
    "test:polls-ui": "node --test tests/polls-ui.cjs",
    "test:voice": "node --test tests/voice-timing.test.cjs tests/voice-mp4.test.cjs",
    "test:voice-ui": "node --test tests/voice-ui.cjs",
    "test:network-ui": "node tests/network-ui.cjs",
    "test:weather": "node --test --test-force-exit tests/weather.test.cjs tests/weather-edge.test.cjs tests/weather-ui.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romentiy2012-droid/mayak-messenger.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/romentiy2012-droid/mayak-messenger/issues"
  },
  "homepage": "https://github.com/romentiy2012-droid/mayak-messenger#readme",
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2"
  },
  "private": true
}
